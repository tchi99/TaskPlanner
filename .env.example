TASKPLANNER_ENV=development
TASKPLANNER_DATABASE_URL=sqlite:///./taskplanner.db
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Use the dedicated non-exposed schema, provisioned separately before migrations.
TASKPLANNER_DATABASE_SCHEMA=taskplanner
# Development only. For production use TASKPLANNER_ENV=production and supabase mode.
# Default auth is fail-closed. local requires explicit offline opt-in.
TASKPLANNER_AUTH_MODE=local
TASKPLANNER_CORS_ORIGINS=http://localhost:5173

# Production: HTTPS Supabase project URL, exact authorized Auth user UUID,
# explicit HTTPS frontend origin; no service-role key or JWT secret needed.
TASKPLANNER_SUPABASE_URL=
TASKPLANNER_SUPABASE_ALLOWED_SUB=
TASKPLANNER_SUPABASE_AUDIENCE=authenticated

# Optional Google Calendar read-only integration (leave empty for offline core / CI).
# Set a short-lived access token OR supply client id + secret + offline refresh token.
# Obtain credentials outside TaskPlanner with the calendar.readonly OAuth scope.
TASKPLANNER_GOOGLE_CALENDAR_IDS=primary
TASKPLANNER_GOOGLE_ACCESS_TOKEN=
TASKPLANNER_GOOGLE_CLIENT_ID=
TASKPLANNER_GOOGLE_CLIENT_SECRET=
TASKPLANNER_GOOGLE_REFRESH_TOKEN=

# Optional TP-050 OpenAI decomposition (server-side only; never put the key in Vite).
TASKPLANNER_OPENAI_API_KEY=
TASKPLANNER_OPENAI_DECOMPOSITION_MODEL=gpt-4o-mini

# Optional TP-051 AI explanation of deterministic planning options (same server-side key).
TASKPLANNER_OPENAI_ARBITRATION_MODEL=gpt-4o-mini
