# Frontend development without external credentials; never effective in production build:
VITE_TASKPLANNER_AUTH_MODE=local

# Authenticated frontend: remove local mode and use public-only values.
# Do NOT place secrets, database passwords or service_role keys in VITE_.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# On Render (production static build), explicitly set the public HTTPS
# FastAPI origin. Local Vite dev continues to proxy relative /api to :8000.
# Never append /api and never include tokens, query strings or credentials.
# VITE_TASKPLANNER_API_URL=https://your-api.onrender.com
